{
  "name": "dsh-deepseek-official-status",
  "version": "0.1.1",
  "description": "在 DSH 会话头部用一颗信号灯实时显示 DeepSeek 官方服务状态（status.deepseek.com）：悬停展开总体状态、各组件与可用率、进行中与最近事件。 Live DeepSeek official service status as a traffic-light dot in the DSH conversation header.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "status",
    "status-page",
    "deepseek",
    "monitor",
    "uptime"
  ],
  "license": "MIT",
  "author": "Fo-Rimuru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fo-Rimuru/dsh-deepseek-official-status.git"
  },
  "homepage": "https://github.com/Fo-Rimuru/dsh-deepseek-official-status#readme",
  "bugs": {
    "url": "https://github.com/Fo-Rimuru/dsh-deepseek-official-status/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "meta": {
    "title": "dsh-deepseek-official-status[官方服务状态]",
    "description": "在会话头部用一颗信号灯实时显示 DeepSeek 官方服务状态（status.deepseek.com）：颜色表示总体状态，悬停展开各组件状态与可用率、进行中与最近事件；读不到数据时明确降级并保留上次快照，绝不假装正常。"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/*.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/parser.test.mjs test/rss.test.mjs && node test/rss-fallback.smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/schemastery": ">=3.18.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1",
    "react": ">=18.2.0"
  }
}
